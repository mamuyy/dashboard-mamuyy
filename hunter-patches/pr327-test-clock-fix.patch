     init_db(db_path)
-    old = (datetime.now(timezone.utc) - timedelta(hours=2)).isoformat()
+    old = (datetime.fromtimestamp(_NOW_EPOCH, timezone.utc) - timedelta(hours=2)).isoformat()
     _insert_trade(db_path, updated_at=old)
     # Base schema lacks ts_epoch -> SCHEMA_UNSUPPORTED. With no fresh point
     # price, the pre-existing stale-symbol release is still allowed.
@@ -486,7 +502,7 @@ def test_klines_hold_cannot_age_a_priced_trade_into_the_stale_symbol_release(
     monkeypatch.setattr(engine, "STALE_SYMBOL_MAX_AGE_HOURS", 0.01)
     db_path = str(tmp_path / "paper.db")
     init_db(db_path)
-    old = (datetime.now(timezone.utc) - timedelta(hours=2)).isoformat()
+    old = (datetime.fromtimestamp(_NOW_EPOCH, timezone.utc) - timedelta(hours=2)).isoformat()
     _insert_trade(db_path, updated_at=old)
     # The symbol IS priced every cycle; only the KLINES source is broken.
     for _ in range(5):
@@ -621,7 +637,7 @@ def test_cp106_bound_is_inoperative_while_the_point_feed_is_healthy(
     monkeypatch.setattr(engine, "STALE_SYMBOL_MAX_AGE_HOURS", 0.01)
     db_path = str(tmp_path / "paper.db")
     init_db(db_path)
-    ancient = (datetime.now(timezone.utc) - timedelta(days=3)).isoformat()
+    ancient = (datetime.fromtimestamp(_NOW_EPOCH, timezone.utc) - timedelta(days=3)).isoformat()
     _insert_trade(db_path, updated_at=ancient)
     # Force updated_at back to "ancient" before EVERY cycle, i.e. simulate the
     # rejected option A in which a HOLD leaves updated_at frozen.
@@ -1379,7 +1395,7 @@ def test_s4_persistent_minority_hold_alerts_below_rate_threshold(tmp_path, monke
 
 def test_s4_persistent_hold_state_is_per_trade_and_resets_on_reason_change(tmp_path):
     db_path = str(tmp_path / "s4-state.db")
-    now = datetime.now(timezone.utc)
+    now = datetime.fromtimestamp(_NOW_EPOCH, timezone.utc)
     with sqlite3.connect(db_path) as connection:
         engine._ensure_klines_persistent_hold_state_table(connection)
         assert engine._update_klines_persistent_hold_state(
@@ -1418,7 +1434,7 @@ def test_s4_no_point_price_hold_still_advances_persistent_timer(tmp_path, monkey
 
     with sqlite3.connect(db_path) as connection:
         engine._ensure_klines_persistent_hold_state_table(connection)
-        old = datetime.now(timezone.utc) - timedelta(minutes=5)
+        old = datetime.fromtimestamp(_NOW_EPOCH, timezone.utc) - timedelta(minutes=5)
         engine._update_klines_persistent_hold_state(
             connection, trade_id=held_id, reason="DB_ERROR", now=old
         )
